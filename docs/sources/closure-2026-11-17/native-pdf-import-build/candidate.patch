+        guard target.hasPrefix("xref"), target.dropFirst(4).first?.isWhitespace == true else {
+            // PDF 1.5+ may store the cross-reference table as an indirect stream.
+            guard target.range(of: #"^[0-9]+\s+[0-9]+\s+obj\b"#, options: .regularExpression) != nil else { throw NotebookError.invalid("Indice PDF danneggiato.") }
+            return
+        }
+    }
+    private static func inherited(_ key: String, from dictionary: CGPDFDictionaryRef) throws -> CGPDFObjectRef? {
+        var current: CGPDFDictionaryRef? = dictionary, seen = Set<UInt>()
+        while let value = current {
+            guard seen.count < 64, seen.insert(UInt(bitPattern: value)).inserted else { throw NotebookError.invalid("Albero delle pagine PDF non valido.") }
+            var object: CGPDFObjectRef?
+            if CGPDFDictionaryGetObject(value, key, &object) { return object }
+            var parent: CGPDFDictionaryRef?
+            if !CGPDFDictionaryGetDictionary(value, "Parent", &parent) { return nil }
+            current = parent
+        }
+        return nil
+    }
+    private static func validateBox(_ object: CGPDFObjectRef?) throws -> CGRect {
+        guard let object else { throw NotebookError.invalid("Dimensioni mancanti nella pagina PDF.") }
+        var array: CGPDFArrayRef?
+        guard CGPDFObjectGetValue(object, .array, &array), let array, CGPDFArrayGetCount(array) == 4 else { throw NotebookError.invalid("Dimensioni PDF non valide.") }
+        var numbers: [CGFloat] = []
+        for index in 0..<4 {
+            var number: CGPDFReal = 0
+            guard CGPDFArrayGetNumber(array,index,&number), number.isFinite, abs(number) <= 1_000_000 else { throw NotebookError.invalid("Coordinate PDF non finite o eccessive.") }
+            numbers.append(number)
+        }
+        let width = numbers[2]-numbers[0], height = numbers[3]-numbers[1]
+        guard width > 0, height > 0, width <= 14_400, height <= 14_400 else { throw NotebookError.invalid("Dimensioni PDF non supportate: lati positivi fino a 14.400 punti.") }
+        return CGRect(x: numbers[0],y: numbers[1],width: width,height: height)
+    }
+    private static func validatePage(_ page: CGPDFPage) throws {
+        guard let dictionary = page.dictionary else { throw NotebookError.invalid("Pagina PDF non valida.") }
+        let media = try validateBox(inherited("MediaBox", from: dictionary))
+        if let crop = try inherited("CropBox", from: dictionary) {
+            let visible = media.intersection(try validateBox(crop))
+            guard !visible.isNull, visible.width > 0, visible.height > 0 else { throw NotebookError.invalid("La pagina PDF non ha un’area visibile valida.") }
+        }
+        if let rotation = try inherited("Rotate", from: dictionary) {
+            var angle: CGPDFInteger = 0
+            guard CGPDFObjectGetValue(rotation, .integer, &angle), angle % 90 == 0, (-360_000...360_000).contains(angle) else { throw NotebookError.invalid("Rotazione PDF non valida: usa multipli di 90°.") }
