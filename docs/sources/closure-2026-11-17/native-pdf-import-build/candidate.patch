+import Foundation
+import CoreGraphics
+import PDFKit
+import CryptoKit
+import NotebookCore
+
+private func pdfFixture(rotations: [Int] = [0], box: String = "0 0 400 200", crop: String = "50 25 350 175", padding: Int = 0, tag: String = "VECTOR", streamOverride: String? = nil) -> Data {
+    var objects = ["<< /Type /Catalog /Pages 2 0 R >>", "<< /Type /Pages /Kids [\(rotations.indices.map { "\(4+2*$0) 0 R" }.joined(separator: " "))] /Count \(rotations.count) >>", "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>"]
+    for (index,rotation) in rotations.enumerated() {
+        let stream = streamOverride ?? "1 0 1 rg 0 0 400 200 re f\n1 0 0 rg 50 25 150 75 re f\n0 1 0 rg 200 25 150 75 re f\n0 0 1 rg 50 100 150 75 re f\n1 1 0 rg 200 100 150 75 re f\n0 0 0 rg BT /F1 12 Tf 70 105 Td (\(tag)-\(index)) Tj ET\n"
+        objects.append("<< /Type /Page /Parent 2 0 R /MediaBox [\(box)] /CropBox [\(crop)] /Rotate \(rotation) /Resources << /Font << /F1 3 0 R >> >> /Contents \(5+2*index) 0 R >>")
+        objects.append("<< /Length \(stream.utf8.count) >>\nstream\n\(stream)endstream")
+    }
+    var pdf = "%PDF-1.7\n", offsets: [Int] = [0]
+    for (index,object) in objects.enumerated() { offsets.append(pdf.utf8.count); pdf += "\(index+1) 0 obj\n\(object)\nendobj\n" }
+    if padding > 0 { pdf += "%" + String(repeating: "x", count: padding) + "\n" }
+    let start = pdf.utf8.count
+    pdf += "xref\n0 \(objects.count+1)\n0000000000 65535 f \n"
+    for offset in offsets.dropFirst() { pdf += String(format: "%010d 00000 n \n", offset) }
+    pdf += "trailer\n<< /Size \(objects.count+1) /Root 1 0 R >>\nstartxref\n\(start)\n%%EOF\n"
+    return Data(pdf.utf8)
+}
+
+func runPDFImportChecks() {
+    check("PDF original bytes/hash retained once; schema 2 roundtrip and repeated import deduplication") {
+        let bytes = pdfFixture(rotations: [0,90,180,270]), asset = try NotebookPDFAsset(data: bytes), original = Notebook()
+        let imported = try NotebookPDFImport.appending(asset, to: original, title: "Esperimenti")
+        try expect(original.schemaVersion == 1 && original.pdfAssets.isEmpty && original.pages.count == 1, "Pure transaction mutated source")
+        try expect(imported.pages.count == 5 && imported.schemaVersion == 2 && imported.pdfAssets.count == 1, "Import shape wrong")
+        try expect(asset.digest == SHA256.hash(data: bytes).map { String(format: "%02x", $0) }.joined(), "Wrong digest")
+        let reopened = try NotebookCodec.decode(NotebookCodec.encode(imported))
+        try expect(reopened == imported && reopened.pdfAssets[0].data == bytes, "Original PDF was rewritten")
+        let repeated = try NotebookPDFImport.appending(asset, to: reopened, title: "Ancora")
+        try expect(repeated.pages.count == 9 && repeated.pdfAssets.count == 1, "Repeated PDF stored more than once")
+        for i in 0..<4 { try expect(imported.pages[i+1].background == PDFBackground(assetDigest: asset.digest,pageIndex: i), "Page reference wrong") }
+    }
+    check("legacy schema 1 stays readable and writable without invented metadata") {
+        let bytes = Data(#"{"format":"ardesia-native-notebook","schemaVersion":1,"id":"10000000-0000-0000-0000-000000000000","title":"Legacy","pages":[{"id":"20000000-0000-0000-0000-000000000000","title":"Originale","paper":"plain","strokes":[]}]}"#.utf8)
+        let legacy = try NotebookCodec.decode(bytes), encoded = try NotebookCodec.encode(legacy)
+        let shape = try JSONSerialization.jsonObject(with: encoded) as! [String: Any]
+        try expect(legacy.schemaVersion == 1 && legacy.pdfAssets.isEmpty && legacy.pages[0].background == nil, "Legacy changed")
+        try expect(shape["pdfAssets"] == nil && (shape["pages"] as! [[String: Any]])[0]["background"] == nil, "Legacy save invented keys")
+    }
+    check("PDF input bounds, encrypted/truncated/corrupt files and invalid page geometry rejected") {
