+        defer { CGPDFOperatorTableRelease(table) }
+        let scanner = CGPDFScannerCreate(content, table, nil)
+        defer { CGPDFScannerRelease(scanner) }
+        guard CGPDFScannerScan(scanner) else { throw NotebookError.invalid("Il contenuto di una pagina PDF è danneggiato.") }
+    }
+}
+
+public enum NotebookPDFImport {
+    /// Pure transaction: no caller state/file changes until every check and the
+    /// complete encoded notebook byte budget have passed.
+    public static func appending(_ asset: NotebookPDFAsset, to notebook: Notebook, title: String) throws -> Notebook {
+        _ = try notebook.validated()
+        guard notebook.pages.count + asset.pageCount <= NotebookLimits.maxPages else { throw NotebookError.invalid("L’importazione supererebbe 64 pagine. Nessuna pagina è stata aggiunta.") }
+        var next = notebook
+        next.schemaVersion = 2
+        if let existing = next.pdfAssets.first(where: { $0.digest == asset.digest }) {
+            guard existing.data == asset.data else { throw NotebookError.invalid("Impronta PDF duplicata con dati differenti.") }
+        } else { next.pdfAssets.append(asset) }
+        let name = title.trimmingCharacters(in: .whitespacesAndNewlines)
+        for index in 0..<asset.pageCount {
+            next.pages.append(NotebookPage(title: String((name.isEmpty ? "PDF" : name).prefix(100)) + " · \(index+1)", paper: .plain, background: PDFBackground(assetDigest: asset.digest, pageIndex: index)))
+        }
+        _ = try NotebookCodec.encode(next)
+        return next
+    }
+}
