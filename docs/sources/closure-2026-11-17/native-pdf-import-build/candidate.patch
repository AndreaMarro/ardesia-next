+import Foundation
+import CoreGraphics
+import CryptoKit
+
+public struct PDFBackground: Codable, Equatable, Sendable {
+    public let assetDigest: String
+    /// Zero-based page index in the unmodified embedded PDF.
+    public let pageIndex: Int
+    public init(assetDigest: String, pageIndex: Int) { self.assetDigest = assetDigest; self.pageIndex = pageIndex }
+}
+
+/// Immutable validated bytes. Derived metadata is rebuilt once on decode/import,
+/// not on each pen sample or notebook validation.
+public struct NotebookPDFAsset: Codable, Equatable, Sendable {
+    public let digest: String
+    public let data: Data
+    public let pageCount: Int
+    let encodedByteCount: Int
+    public static let maxInputBytes = 12 * 1024 * 1024
+    private enum CodingKeys: String, CodingKey { case digest, data }
+
+    public init(data: Data) throws {
+        guard !data.isEmpty, data.count <= Self.maxInputBytes else { throw NotebookError.invalid("Il PDF deve contenere dati e non superare 12 MiB.") }
+        try Self.checkEnvelope(data)
+        let document = try Self.document(data)
+        guard !document.isEncrypted else { throw NotebookError.invalid("I PDF protetti o cifrati non sono supportati. L’originale non è stato modificato.") }
+        guard (1...NotebookLimits.maxPages).contains(document.numberOfPages) else { throw NotebookError.invalid("Il PDF deve contenere da 1 a 64 pagine.") }
+        for index in 1...document.numberOfPages {
+            guard let page = document.page(at: index) else { throw NotebookError.invalid("Il PDF contiene una pagina non leggibile.") }
+            try Self.validatePage(page)
+        }
+        self.data = data
+        let hash = SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+        digest = hash; pageCount = document.numberOfPages
+        // Exact JSON/base64 cost cached as an integer; no duplicate PDF/string
+        // retained, and no base64 encoding while drawing or validating edits.
+        struct Payload: Encodable { let digest: String; let data: Data }
+        let encoder = JSONEncoder(); encoder.outputFormatting = [.sortedKeys]
+        encodedByteCount = try encoder.encode(Payload(digest: hash,data: data)).count
+    }
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        let expected = try container.decode(String.self, forKey: .digest)
+        try self.init(data: container.decode(Data.self, forKey: .data))
+        guard expected == digest else { throw NotebookError.invalid("Il PDF incorporato non corrisponde alla sua impronta SHA-256.") }
+    }
+    public func encode(to encoder: Encoder) throws {
+        var container = encoder.container(keyedBy: CodingKeys.self)
+        try container.encode(digest, forKey: .digest); try container.encode(data, forKey: .data)
+    }
+    public func document() throws -> CGPDFDocument { try Self.document(data) }
+    private static func document(_ data: Data) throws -> CGPDFDocument {
+        guard let provider = CGDataProvider(data: data as CFData), let document = CGPDFDocument(provider) else { throw NotebookError.invalid("Il file non è un PDF leggibile.") }
+        return document
+    }
+    public static func read(_ url: URL) throws -> Self {
+        let values = try url.resourceValues(forKeys: [.isRegularFileKey, .fileSizeKey])
+        guard values.isRegularFile == true, (values.fileSize ?? Int.max) <= maxInputBytes else { throw NotebookError.invalid("Scegli un file PDF regolare, fino a 12 MiB.") }
+        let handle = try FileHandle(forReadingFrom: url); defer { try? handle.close() }
+        return try Self(data: handle.read(upToCount: maxInputBytes + 1) ?? Data())
+    }
+    private static func checkEnvelope(_ data: Data) throws {
+        guard data.starts(with: Data("%PDF-".utf8)),
+              let marker = data.range(of: Data("startxref".utf8), options: .backwards),
+              let tail = String(data: data[marker.lowerBound...], encoding: .ascii) else { throw NotebookError.invalid("Intestazione o chiusura PDF non valida.") }
+        let parts = tail.split(whereSeparator: { $0.isWhitespace })
+        guard parts.count == 3, parts[0] == "startxref", parts[2] == "%%EOF", let offset = Int(parts[1]), offset >= 0, offset < marker.lowerBound else { throw NotebookError.invalid("Indice PDF non valido o file troncato.") }
