{
  "name": "ardesia-next",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node tools/server.mjs --dev",
    "build": "node tools/build.mjs",
    "preview": "node tools/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tools/e2e.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:budget": "node tools/check-budget.mjs",
    "verify": "node tools/verify.mjs",
    "status": "node tools/status.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "pg": "8.23.1"
  },
  "dependencies": {
    "@ardesia/server": "0.1.0"
  }
}
