diff --git a/packages/contracts/src/courses.ts b/packages/contracts/src/courses.ts
new file mode 100644
index 0000000..23de268
--- /dev/null
+++ b/packages/contracts/src/courses.ts
@@ -0,0 +1,98 @@
+import {z} from 'zod';
+
+const id = z.string().min(1).max(200).regex(/^[A-Za-z0-9][A-Za-z0-9._:-]*$/);
+const revision = z.number().int().positive();
+const title = z.string().trim().min(1).max(240);
+const text = z.string().trim().max(10_000);
+const timestamp = z.iso.datetime();
+export const CourseSourceSchema = z.object({
+  title, url: z.url().refine(value => ['http:', 'https:'].includes(new URL(value).protocol)),
+  revision: z.string().trim().min(1).max(300), license: z.string().trim().min(1).max(300),
+}).strict();
+/** A lesson link grants only this exact revision through an active course delivery. */
+export const CourseUnitInputSchema = z.object({
+  id, title, objective: text, prerequisites: text, explanation: text,
+  prediction: text, activity: text, referenceFeedback: text, recovery: text, transfer: text,
+  sources: z.array(CourseSourceSchema).max(32),
+  lesson: z.object({documentId: id, revision}).strict().nullable(),
+}).strict();
+export const CourseUnitSchema = CourseUnitInputSchema.extend({revision}).strict();
+export const CourseInputSchema = z.object({
+  title, description: text, license: z.string().trim().min(1).max(300),
+  units: z.array(CourseUnitInputSchema).min(1).max(100),
+}).strict().refine(value => new Set(value.units.map(unit => unit.id)).size === value.units.length, 'Unit IDs must be unique');
+export const CourseSchema = z.object({
+  id, ownerId: id, revision, status: z.literal('draft'), title, description: text,
+  license: z.string().trim().min(1).max(300), units: z.array(CourseUnitSchema).min(1).max(100),
+  createdAt: timestamp, updatedAt: timestamp,
+}).strict().refine(value => new Set(value.units.map(unit => unit.id)).size === value.units.length, 'Unit IDs must be unique');
+export type Course = z.infer<typeof CourseSchema>;
+export type CourseInput = z.infer<typeof CourseInputSchema>;
+export type CourseUnit = z.infer<typeof CourseUnitSchema>;
+export const CourseEditionSchema = z.object({
+  id, courseId: id, courseRevision: revision, courseDigest: z.string().regex(/^[a-f0-9]{64}$/),
+  ownerId: id, revision: z.literal(1), label: title, status: z.literal('draft'), createdAt: timestamp,
+}).strict();
+export type CourseEdition = z.infer<typeof CourseEditionSchema>;
+export const CourseDeliverySchema = z.object({
+  id, editionId: id, ownerId: id, learnerId: id, revision,
+  status: z.enum(['active', 'revoked']), createdAt: timestamp, updatedAt: timestamp,
+}).strict();
+export type CourseDelivery = z.infer<typeof CourseDeliverySchema>;
+export const CourseStageSchema = z.enum(['prediction', 'activity', 'transfer']);
+export const CourseHelpSchema = z.enum(['explanation', 'referenceFeedback', 'recovery']);
+export const CourseWorkSchema = z.object({
+  id, revision, currentUnitId: id, currentStage: CourseStageSchema, shared: z.boolean(), createdAt: timestamp, updatedAt: timestamp,
+  attempts: z.array(z.object({
+    id, unitId: id, unitRevision: revision, stage: CourseStageSchema,
+    answer: text.refine(value => value.length > 0), createdAt: timestamp,
+    helpUsed: z.array(CourseHelpSchema).max(3),
+  }).strict()).max(2_000),
+  help: z.array(z.object({unitId: id, kind: CourseHelpSchema, firstViewedAt: timestamp}).strict()).max(300),
+}).strict().superRefine((work, ctx) => {
+  if (new Set(work.attempts.map(item => item.id)).size !== work.attempts.length
+    || new Set(work.help.map(item => item.unitId + ':' + item.kind)).size !== work.help.length) {
+    ctx.addIssue({code: 'custom', message: 'Course evidence identities must be unique'});
+  }
+});
+export type CourseWork = z.infer<typeof CourseWorkSchema>;
+const fields = {commandId: id, expectedRevision: z.number().int().nonnegative()};
+export const CourseCommandKinds = ['save-course', 'create-course-edition', 'assign-course', 'revoke-course-delivery',
+  'set-course-position', 'record-course-attempt', 'view-course-help', 'share-course-work'] as const;
+export const CourseCommandSchema = z.discriminatedUnion('kind', [
+  z.object({...fields, kind: z.literal('save-course'), courseId: id, input: CourseInputSchema}).strict(),
+  z.object({...fields, kind: z.literal('create-course-edition'), expectedRevision: z.literal(0), editionId: id,
+    courseId: id, courseRevision: revision, label: title}).strict(),
+  z.object({...fields, kind: z.literal('assign-course'), expectedRevision: z.literal(0), deliveryId: id, editionId: id, learnerId: id}).strict(),
+  z.object({...fields, kind: z.literal('revoke-course-delivery'), deliveryId: id}).strict(),
+  z.object({...fields, kind: z.literal('set-course-position'), deliveryId: id, unitId: id, stage: CourseStageSchema.optional()}).strict(),
+  z.object({...fields, kind: z.literal('record-course-attempt'), deliveryId: id, unitId: id,
+    stage: CourseStageSchema, attemptId: id, answer: text.refine(value => value.length > 0)}).strict(),
+  z.object({...fields, kind: z.literal('view-course-help'), deliveryId: id, unitId: id, help: CourseHelpSchema}).strict(),
+  z.object({...fields, kind: z.literal('share-course-work'), deliveryId: id, shared: z.boolean()}).strict(),
+]);
+export const CourseAuthorCommandSchema = z.discriminatedUnion('kind', [CourseCommandSchema.options[0], CourseCommandSchema.options[1]]);
+export type CourseAuthorCommand = z.infer<typeof CourseAuthorCommandSchema>;
+export type CourseCommand = z.infer<typeof CourseCommandSchema>;
+const entity = z.enum(['course', 'edition', 'delivery', 'course-work']);
+export const CourseEventSchema = z.object({
+  id, sequence: revision, courseEntity: entity, entityId: id, entityRevision: revision,
+  type: z.enum(CourseCommandKinds), actorId: id, actorRole: z.enum(['teacher', 'student']), occurredAt: timestamp,
+  payload: z.object({command: CourseCommandSchema, value: z.union([CourseSchema, CourseEditionSchema, CourseDeliverySchema, CourseWorkSchema])}).strict(),
+}).strict();
+export type CourseEvent = z.infer<typeof CourseEventSchema>;
+export const CourseReceiptSchema = z.object({
+  commandId: id, actorId: id, fingerprint: z.string().regex(/^[a-f0-9]{64}$/),
+  courseEntity: entity, entityId: id, entityRevision: revision, eventId: id,
+}).strict();
+export type CourseReceipt = z.infer<typeof CourseReceiptSchema>;
+export const CourseSpaceSchema = z.object({
+  courses: z.array(CourseSchema), editions: z.array(z.object({edition: CourseEditionSchema, course: CourseSchema}).strict()),
+  deliveries: z.array(CourseDeliverySchema), work: z.array(CourseWorkSchema),
+}).strict();
+export type CourseSpace = z.infer<typeof CourseSpaceSchema>;
+export function courseTarget(command: CourseCommand): {courseEntity: CourseReceipt['courseEntity']; entityId: string} {
+  if (command.kind === 'save-course') return {courseEntity: 'course', entityId: command.courseId};
+  if (command.kind === 'create-course-edition') return {courseEntity: 'edition', entityId: command.editionId};
+  return {courseEntity: command.kind === 'assign-course' || command.kind === 'revoke-course-delivery' ? 'delivery' : 'course-work', entityId: command.deliveryId};
+}
diff --git a/packages/contracts/src/document-history.ts b/packages/contracts/src/document-history.ts
new file mode 100644
index 0000000..ca15910
--- /dev/null
+++ b/packages/contracts/src/document-history.ts
@@ -0,0 +1,61 @@
+import {canonicalJson, CoreError, CoreEventSchema, EducationalObjectSchema, LessonDocumentSchema, type CoreEvent, type LessonDocument} from './index';
+
+const record = (value: unknown): value is Record<string, unknown> => !!value && typeof value === 'object' && !Array.isArray(value);
+function invalid(): never {throw new CoreError('INVALID_SNAPSHOT', 'Exact replay requires the complete, coherent authorized document history.');}
+
+/** Rebuild a document from its existing Core events. No stored scene or second journal. */
+export function projectDocumentRevision(input: readonly CoreEvent[], documentId: string, wanted: number): LessonDocument {
+  if (!Number.isInteger(wanted) || wanted < 1) return invalid();
+  const events = input.filter(event => event.documentId === documentId).sort((a, b) => a.documentRevision - b.documentRevision);
+  let document: LessonDocument | undefined;
+  const seen = new Set<string>(), objectIds = new Set<string>();
+  for (let index = 0; index < wanted; index++) {
+    const parsed = CoreEventSchema.safeParse(events[index]); if (!parsed.success) return invalid();
+    const event = parsed.data;
+    if (event.documentRevision !== index + 1 || seen.has(event.id) || !record(event.payload)) return invalid();
+    seen.add(event.id); const payload = event.payload;
+    if (index === 0) {
+      if (event.type !== 'create-document' || typeof payload.title !== 'string') return invalid();
+      document = LessonDocumentSchema.parse({id: documentId, ownerId: event.actorId, title: payload.title,
+        revision: 1, status: 'draft', createdAt: event.occurredAt, updatedAt: event.occurredAt, objects: [], connections: []});
+      continue;
+    }
+    if (!document || document.ownerId !== event.actorId) return invalid();
+    const object = () => {const result = EducationalObjectSchema.safeParse(payload.object); return result.success ? result.data : invalid();};
+    if (event.type === 'rename-document') {
+      if (typeof payload.title !== 'string' || payload.previousTitle !== document.title) return invalid();
+      document.title = payload.title;
+    } else if (event.type === 'add-object') {
+      const next = object(); if (objectIds.has(next.id) || next.revision !== 1) return invalid();
+      objectIds.add(next.id); document.objects.push(next);
+    } else if (event.type === 'replace-object' || event.type === 'move-object') {
+      const next = object(), previous = document.objects.find(value => value.id === next.id);
+      if (!previous || next.revision !== previous.revision + 1 || canonicalJson(payload.previous) !== canonicalJson(previous)) return invalid();
+      document.objects = document.objects.map(value => value.id === next.id ? next : value);
+    } else if (event.type === 'remove-object') {
+      const previous = EducationalObjectSchema.safeParse(payload.previous);
+      if (!previous.success || !document.objects.some(value => value.id === previous.data.id && canonicalJson(value) === canonicalJson(previous.data))) return invalid();
+      document.objects = document.objects.filter(value => value.id !== previous.data.id);
+      document.connections = document.connections.filter(value => value.from !== previous.data.id && value.to !== previous.data.id);
+    } else if (event.type === 'connect-objects') {
+      if (!record(payload.connection)) return invalid();
+      // The document schema validates IDs and endpoints together below.
+      document.connections.push(payload.connection as unknown as LessonDocument['connections'][number]);
+    } else if (event.type === 'disconnect-objects') {
+      if (!record(payload.previous) || typeof payload.previous.id !== 'string') return invalid();
+      const id = payload.previous.id;
+      if (!document.connections.some(value => value.id === id && canonicalJson(value) === canonicalJson(payload.previous))) return invalid();
+      document.connections = document.connections.filter(value => value.id !== id);
+    } else if (event.type === 'plugin-release-changed') {
+      if (!Array.isArray(payload.objects)) return invalid();
+      for (const change of payload.objects) {
+        if (!record(change)) return invalid();
+        const next = EducationalObjectSchema.safeParse(change.object);
+        if (!next.success || !document.objects.some(value => value.id === next.data.id && value.revision + 1 === next.data.revision && canonicalJson(change.previous) === canonicalJson(value))) return invalid();
+        document.objects = document.objects.map(value => value.id === next.data.id ? next.data : value);
+      }
+    } else return invalid();
+    document = LessonDocumentSchema.parse({...document, revision: event.documentRevision, updatedAt: event.occurredAt});
+  }
+  return document ?? invalid();
+}
diff --git a/packages/contracts/src/extensions.ts b/packages/contracts/src/extensions.ts
new file mode 100644
index 0000000..510bbe5
--- /dev/null
+++ b/packages/contracts/src/extensions.ts
@@ -0,0 +1,113 @@
+import {z} from 'zod';
+
+export const COMPOSITION_RENDERER = 'ardesia.composition/1';
+const key = z.string().regex(/^[a-zA-Z][a-zA-Z0-9_]{0,63}$/).refine(value=>!['constructor','prototype','__proto__'].includes(value));
+const short = z.string().min(1).max(240);
+export type ExtensionValue = null | boolean | number | string | ExtensionValue[] | {[key:string]:ExtensionValue};
+/** Bounds are resource budgets, not a catalog of educational object types. */
+export function isExtensionJson(value: unknown): value is ExtensionValue {
+  const stack = [{value,depth:0}], seen = new Set<object>(); let count = 0;
+  try {
+    while(stack.length) {
+      const {value,depth} = stack.pop()!;
+      if(++count>8_000 || depth>20) return false;
+      if(value===null||typeof value==='boolean') continue;
+      if(typeof value==='number') {if(!Number.isFinite(value))return false;continue;}
+      if(typeof value==='string') {if(value.length>32_768)return false;continue;}
+      if(typeof value!=='object'||seen.has(value))return false;
+      seen.add(value);
+      if(!Array.isArray(value)&&Object.getPrototypeOf(value)!==Object.prototype&&Object.getPrototypeOf(value)!==null)return false;
+      if(Object.getOwnPropertySymbols(value).length)return false;
+      const entries=Object.getOwnPropertyDescriptors(value);
+      if(Array.isArray(value)&&(Object.keys(entries).length!==value.length+1||Object.keys(entries).filter(k=>k!=='length').some((k,i)=>k!==String(i))))return false;
+      for(const [name,d] of Object.entries(entries)) {
+        if(Array.isArray(value)&&name==='length')continue;
+        if(['__proto__','constructor','prototype'].includes(name)||name.length>200||!d.enumerable||!('value'in d))return false;
+        stack.push({value:d.value,depth:depth+1});
+      }
+    }
+    return new TextEncoder().encode(JSON.stringify(value)).byteLength<=131_072;
+  }catch{return false;}
+}
+const Json = z.custom<ExtensionValue>(isExtensionJson);
+const Primitive = z.union([z.number().finite(),z.string().max(10_000),z.boolean()]);
+export const CompositionFieldSchema = z.strictObject({
+  key:key.refine(v=>!['pi','e','true','false'].includes(v)), label:short, kind:z.enum(['number','text','boolean']), initial:Primitive,
+  min:z.number().finite().optional(),max:z.number().finite().optional(),step:z.number().positive().optional(),unit:z.string().max(40).optional(),
+}).superRefine((field,ctx)=>{
+  if(typeof field.initial!==({number:'number',text:'string',boolean:'boolean'} as const)[field.kind])ctx.addIssue({code:'custom',message:'Initial value does not match field type'});
+  if(field.kind==='number' && (field.min!==undefined&&field.max!==undefined&&field.min>=field.max || typeof field.initial==='number'&&(field.min!==undefined&&field.initial<field.min || field.max!==undefined&&field.initial>field.max)))ctx.addIssue({code:'custom',message:'Invalid numeric range'});
