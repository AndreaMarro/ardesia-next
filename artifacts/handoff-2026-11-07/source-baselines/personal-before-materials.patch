 .learner-shell{min-height:100dvh;background:var(--surface,#f7f6f2)}.learner-header{padding:20px clamp(20px,4vw,64px);border-bottom:1px solid var(--border,#ddd);background:var(--paper,#fff)}.learner-main{max-width:1450px;padding:28px clamp(18px,4vw,60px) 60px;margin:auto}.learner-main>nav{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:24px}.learner-main>header{margin-bottom:24px}
 .learner-content{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,400px);gap:28px;align-items:start}.learner-content .document-view{padding:0}.learner-notes,.learner-consent{background:var(--paper,#fff);border:1px solid var(--border,#ddd);padding:24px;border-radius:16px;display:grid;gap:16px;margin-top:20px}.learner-notes h2,.learner-notes p{margin:0}.learner-lab{position:sticky;top:20px}.learner-lab .inspector{position:relative;inset:auto;z-index:auto;width:100%;height:auto;max-height:none;border:1px solid var(--border,#ddd);border-radius:16px;box-sizing:border-box}.learner-lab>.secondary-button{margin:12px 0;width:100%}
 .consent-option{display:flex!important;align-items:flex-start;gap:12px;line-height:1.5;font-weight:400!important}.consent-option input{width:22px!important;height:22px;min-height:22px!important;flex:none;margin-top:2px}
 @media(max-width:900px){.learner-content{grid-template-columns:1fr}.learner-lab{position:static}.app-header{gap:8px}.app-header>.secondary-button{font-size:12px;padding:8px}.space-name{display:none}.remote-status{display:none}.account-page{padding:16px}.account-card{padding:24px}}
+
+/* The same world coordinates on desktop and tablet; chrome stays in screen space. */
+.spatial-board .board-surface {width:100%;height:100%;min-width:0;min-height:0;overflow:hidden;touch-action:none;outline-offset:-3px;}
+.board-world {position:absolute;inset:0;transform-origin:0 0;pointer-events:none;}
+.board-world .board-object {pointer-events:auto;}
+.drawing .board-world .board-object,.panning .board-world .board-object {pointer-events:none;}
+.spatial-board.panning .board-surface {cursor:grab;}
+.spatial-board .ink-content {min-height:0;}
+.board-navigation {position:absolute;top:14px;right:16px;display:flex;align-items:center;gap:2px;background:white;border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow);}
+.board-navigation button {display:flex;align-items:center;justify-content:center;min-width:44px;padding:0 10px;font-size:12px;background:transparent;border:0;color:var(--muted);}
+.board-navigation button:hover,.pen-options button:hover {background:var(--bg);}
+.pen-options {position:absolute;left:16px;top:14px;display:flex;background:white;border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow);}
+.pen-options button {width:44px;border:0;background:transparent;display:grid;place-items:center;}
+.pen-options button span {width:16px;height:16px;border-radius:50%;}
+.pen-options button[aria-pressed=true] span {outline:1px solid var(--muted);outline-offset:4px;}
+.pen-options select {width:85px;border:0;background:transparent;font-size:12px;}
+.pending-ink {position:absolute;overflow:visible;pointer-events:none;opacity:.65;}
+.pending-drawer {position:fixed;left:50%;top:8px;transform:translateX(-50%);z-index:60;width:min(640px,calc(100% - 24px));max-height:65dvh;overflow:auto;box-shadow:var(--shadow);}
+.pending-drawer:has(details[open]) {position:relative;left:auto;top:auto;transform:none;width:auto;max-height:none;}
+.pending-drawer summary {cursor:pointer;min-height:44px;display:flex;align-items:center;font-size:13px;}
+.spatial-board .canvas-empty {pointer-events:none;}
+.spatial-board .canvas-empty button {pointer-events:auto;}
+@media(max-width:760px){.board-navigation{top:10px;right:10px;}.pen-options{top:64px;left:10px;}.spatial-board .canvas-empty{position:absolute;top:100px;left:10%;width:80%;padding:0;transform:none;}.board-toolbar{overflow-x:auto;}}
+/* Ink geometry must not inherit button borders or a 44px layout height. */
+.spatial-board .board-object.type-ink {border:0;min-width:0;min-height:0;padding:0;}
+
+/* Keep a 44px screen-space hit target without changing persisted ink geometry. */
+.spatial-board .board-object.type-ink::after {content:"";position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:max(100%,calc(44px / var(--board-zoom)));height:max(100%,calc(44px / var(--board-zoom)));}
+.offline-workspace{min-height:100dvh;background:var(--bg);color:var(--ink)}
+.offline-heading{display:flex;align-items:center;gap:28px;padding:20px 32px;border-bottom:1px solid var(--line);background:var(--surface)}
+.offline-heading>div{flex:1}.offline-heading p,.offline-notice p{margin:6px 0;color:var(--muted);font-size:14px;line-height:1.6}
+.offline-main{max-width:1600px;margin:0 auto;padding:24px 32px}.offline-notice{display:flex;justify-content:space-between;align-items:center;gap:32px;margin-bottom:20px}
+.offline-notice h1{margin:0;font-family:var(--font-reading);font-size:30px}.offline-actions{display:flex;flex-direction:column;gap:10px;flex-shrink:0}
+.offline-main .board-region{height:60dvh;min-height:420px;border:1px solid var(--line);border-radius:12px;overflow:hidden}
+.offline-footnote{color:var(--muted);font-size:13px;line-height:1.6}.offline-selector{display:flex;gap:12px;align-items:center;margin-bottom:16px}.offline-selector select{min-height:44px;max-width:70%;border:1px solid var(--line);border-radius:8px;background:white;padding:8px}
+@media(max-width:760px){.offline-heading{padding:16px;gap:16px;flex-wrap:wrap}.offline-heading>div{flex-basis:50%}.offline-main{padding:16px}.offline-notice{display:block}.offline-actions{flex-direction:row;flex-wrap:wrap;margin-top:12px}.offline-notice h1{font-size:26px}.offline-main .board-region{height:60dvh;min-height:380px}}
+
+.offline-settings{padding:16px 0;border-block:1px solid var(--line);margin:16px 0}.offline-settings h2{font:600 22px var(--font-reading);margin:0}.offline-settings p{font-size:14px;line-height:1.6}
+
+/* Audio belongs to the lesson; its panel leaves the writing surface visible. */
+.lesson-content {display:flex;flex-direction:column;flex:1;min-height:0;min-width:0}
+.lesson-stage {display:flex;flex-direction:column;flex:1;min-height:0;min-width:0}
+.lesson-stage>.board-region {min-height:0}
+.audio-session {flex:0 0 auto;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#fbfcf9;position:relative;z-index:3}
+.audio-heading {display:flex;align-items:center;gap:12px;min-height:48px;padding:0 24px;flex-wrap:wrap}
+.audio-heading button {min-height:44px}
+.audio-panel {padding:8px 24px 24px;max-height:340px;overflow:auto;font-size:14px}
+.audio-panel p {line-height:1.55;color:#54615b;margin:8px 0 14px}
+.audio-panel h2 {font-size:16px;margin:20px 0 10px}
+.audio-panel label {display:flex;flex-direction:column;gap:6px;margin:10px 0}
+.audio-panel .consent-option {flex-direction:row;align-items:center}
+.audio-panel input:not([type=checkbox]),.audio-panel textarea,.audio-panel select {min-height:44px;border:1px solid #cad3cb;border-radius:8px;padding:10px;background:white;color:#24342d;max-width:100%}
+.audio-panel textarea {min-height:80px;resize:vertical}
+.audio-list>div {display:flex;gap:10px;align-items:center;flex-wrap:wrap;border-bottom:1px solid #e3e8e1;padding:10px 0}
+.audio-list>div>span {flex:1 1 260px}
+.audio-player audio {width:min(100%,640px)}
+.audio-player input[type=range] {width:100%;padding:0}
+.audio-panel .recording-live {color:#a23f39}
+.transcript-panel {max-width:800px}
+.transcript-cues {display:grid;gap:6px;max-height:180px;overflow:auto;margin:12px 0}
+.transcript-cues button {display:flex;gap:16px;align-items:baseline;text-align:left;background:#eff3ed;border:0;border-radius:8px;padding:12px;min-height:44px;color:#24342d}
+.transcript-cues time {font-variant-numeric:tabular-nums;color:#657c6d}
+.cue-times {display:flex;gap:14px}
+.cue-times label {max-width:160px}
+@media(min-width:901px){
+  .lesson-content:has(.audio-session.is-open) {flex-direction:row-reverse}
+  .audio-session.is-open {width:360px;max-width:42%;display:flex;flex-direction:column;min-height:0;border-left:1px solid var(--line);border-bottom:0}
+  .audio-session.is-open .audio-heading {padding:8px 16px;gap:4px;border-bottom:1px solid var(--line)}
+  .audio-session.is-open .audio-panel {padding:8px 16px 24px;flex:1;min-height:0;max-height:none}
+  .lesson-content:has(.audio-session.is-open) .object-strip h2 {display:none}
+}
+@media(max-width:900px){.audio-heading{padding:0 12px;gap:6px}.audio-panel{padding:8px 12px 20px;max-height:min(260px,30dvh)}.audio-heading button{font-size:12px}.cue-times label{max-width:130px}}
