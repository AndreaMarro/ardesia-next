{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Ardesia Next observed release evidence",
  "type":"object",
  "$comment":"tools/status.mjs also verifies exact current SHA/digest and compares the decoded SSO redirect target origin with url; these cross-field checks cannot be expressed by standard JSON Schema alone.",
  "required":["repository","visibility","commit","sourceDigest","projectId","status","target","providerTarget","url","deploymentId","ci","buildInfo","protection","observedAt"],
  "properties":{
    "repository":{"const":"AndreaMarro/ardesia-next"},
    "visibility":{"const":"private"},
    "commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "sourceDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "projectId":{"const":"prj_GGKjCPG4cdgaQDQQMJoFvsy2ffSd"},
    "status":{"const":"READY"},
    "target":{"const":"preview"},
    "providerTarget":{"enum":["staging",null],"description":"Observed raw Vercel API target. staging and explicit null mean preview; production is never accepted."},
    "url":{"type":"string","format":"uri","pattern":"^https://","minLength":9},
    "deploymentId":{"type":"string","pattern":"^dpl_[A-Za-z0-9]{1,128}$"},
    "ci":{"type":"object","required":["headSha","conclusion","url"],"properties":{"headSha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"conclusion":{"const":"success"},"url":{"type":"string","format":"uri","pattern":"^https://","minLength":9}}},
    "buildInfo":{"type":"object","required":["commit","sourceDigest"],"properties":{"commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},"sourceDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "protection":{
      "type":"object",
      "required":["deploymentType","anonymousStatus"],
      "properties":{
        "deploymentType":{"const":"all"},
        "anonymousStatus":{"enum":[401,403,302,303,307]},
        "anonymousLocation":{"type":"string","format":"uri","pattern":"^https://vercel\\.com(?::443)?/sso-api\\?","description":"For a redirect, exactly one decoded url parameter must be HTTPS and have the same origin as the deployment url. tools/status.mjs enforces this."}
      },
      "allOf":[{"if":{"properties":{"anonymousStatus":{"enum":[302,303,307]}},"required":["anonymousStatus"]},"then":{"required":["anonymousLocation"]}}]
    },
    "observedAt":{"type":"string","format":"date-time"}
  }
}
